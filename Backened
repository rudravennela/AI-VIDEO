// Node.js backend for an AI video builder. Requires Node 18+.
// Set REPLICATE_API_TOKEN and REPLICATE_MODEL (for example, owner/model).
const http = require('node:http');

const PORT = Number(process.env.PORT) || 3000;
const TOKEN = process.env.REPLICATE_API_TOKEN;
const MODEL = process.env.REPLICATE_MODEL || '';
const REPLICATE_API = 'https://api.replicate.com/v1';

function respond(res, status, payload) {
	res.writeHead(status, {
		'Content-Type': 'application/json; charset=utf-8',
		'Access-Control-Allow-Origin': '*',
		'Access-Control-Allow-Methods': 'GET, POST, OPTIONS',
		'Access-Control-Allow-Headers': 'Content-Type',
	});
	res.end(status === 204 ? '' : JSON.stringify(payload));
}

function readJson(req) {
	return new Promise((resolve, reject) => {
		let body = '';
		req.on('data', (chunk) => {
			body += chunk;
			if (body.length > 1_000_000) {
				reject(Object.assign(new Error('Request body exceeds 1 MB.'), { status: 413 }));
				req.pause();
			}
		});
		req.on('end', () => {
			try {
				resolve(body ? JSON.parse(body) : {});
			} catch {
				reject(Object.assign(new Error('Request body must be valid JSON.'), { status: 400 }));
			}
		});
		req.on('error', reject);
	});
}

async function callReplicate(path, options = {}) {
	const response = await fetch(`${REPLICATE_API}${path}`, {
		...options,
		headers: {
			Authorization: `Bearer ${TOKEN}`,
			'Content-Type': 'application/json',
			...options.headers,
		},
	});
	const data = await response.json().catch(() => ({}));
	if (!response.ok) {
		const error = new Error(data.detail || data.title || 'Video generation provider error.');
		error.status = response.status;
		throw error;
	}
	return data;
}

const server = http.createServer(async (req, res) => {
	if (req.method === 'OPTIONS') return respond(res, 204);

	const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
	try {
		if (req.method === 'GET' && url.pathname === '/api/health') {
			return respond(res, 200, { status: 'ok', configured: Boolean(TOKEN && MODEL) });
		}

		if (req.method === 'POST' && url.pathname === '/api/videos') {
			if (!TOKEN || !MODEL.includes('/')) {
				return respond(res, 503, { error: 'Configure REPLICATE_API_TOKEN and REPLICATE_MODEL (owner/model).' });
			}
			const body = await readJson(req);
			const prompt = typeof body.prompt === 'string' ? body.prompt.trim() : '';
			if (!prompt) return respond(res, 400, { error: 'A non-empty prompt is required.' });

			const [owner, ...modelParts] = MODEL.split('/');
			const model = modelParts.join('/');
			const settings = body.options && typeof body.options === 'object' && !Array.isArray(body.options)
				? body.options
				: {};
			const prediction = await callReplicate(
				`/models/${encodeURIComponent(owner)}/${encodeURIComponent(model)}/predictions`,
				{ method: 'POST', headers: { Prefer: 'wait=1' }, body: JSON.stringify({ input: { ...settings, prompt } }) },
			);
			return respond(res, 202, {
				id: prediction.id,
				status: prediction.status,
				output: prediction.output ?? null,
				statusUrl: `/api/videos/${encodeURIComponent(prediction.id)}`,
			});
		}

		const match = req.method === 'GET' && url.pathname.match(/^\/api\/videos\/([^/]+)$/);
		if (match) {
			if (!TOKEN) return respond(res, 503, { error: 'Configure REPLICATE_API_TOKEN.' });
			const prediction = await callReplicate(`/predictions/${encodeURIComponent(match[1])}`);
			return respond(res, 200, {
				id: prediction.id,
				status: prediction.status,
				output: prediction.output ?? null,
				error: prediction.error ?? null,
			});
		}

		return respond(res, 404, { error: 'Not found.' });
	} catch (error) {
		return respond(res, error.status || 500, { error: error.message || 'Internal server error.' });
	}
});

server.listen(PORT, () => console.log(`AI video backend listening on port ${PORT}`));
